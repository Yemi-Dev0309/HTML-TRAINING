  <div style="" data-display-unit="" data-id="264563" data-category-click="click" data-category-impression="impression" data-context-type="article" data-special="nothing" data-article-id="222915" data-type-of="partner" data-is-billboard-visible="false">
      

<script>
(function() {
  var PUBLISHER = "dev-to-a7719188-96dc-43cf-ad0b-5e540fc0f4c3";
  var PUBLISHER_KEY = "pub_public_2bb076ccc4f95f39416cb67733ed15bc0b97cb5ec796ebcaf76bcbe7247b55dc";
  var PLACEMENT = "default_card";

  var currentScript = document.currentScript;
  var prev = currentScript && currentScript.previousElementSibling;
  var slot = (prev && prev.classList.contains("dailydev-ad-slot"))
    ? prev
    : document.querySelector(".dailydev-ad-slot:not([data-initialized])");

  if (!slot || slot.dataset.initialized) return;
  slot.dataset.initialized = "true";

  function extractContextTags() {
    var tags = [];
    document.querySelectorAll(".crayons-tag, [data-tag]").forEach(function(el) {
      if (el.closest(".crayons-bb")) return;
      var tag = el.textContent.trim().replace(/^#/, "").toLowerCase();
      if (tag && tags.indexOf(tag) === -1) tags.push(tag);
    });
    return tags.slice(0, 20);
  }

  function detectPlatform() {
    var ua = navigator.userAgent;
    if (/iPhone|iPad|iPod/i.test(ua)) return "ios";
    if (/Android/i.test(ua)) return "android";
    if (/Macintosh|Mac OS X/i.test(ua)) return "macos";
    if (/Windows/i.test(ua)) return "windows";
    if (/Linux/i.test(ua)) return "linux";
    return "other";
  }

  // Impression endpoints expect GET; sendBeacon sends POST, so use a pixel.
  function firePixel(url) {
    try {
      var img = new Image(1, 1);
      img.referrerPolicy = "no-referrer-when-downgrade";
      img.src = url;
    } catch (e) {
      fetch(url, { method: "GET", mode: "no-cors", keepalive: true }).catch(function() {});
    }
  }

  async function loadAd() {
    try {
      var cookiesAllowed = false;
      try { cookiesAllowed = localStorage.getItem("cookie_status") === "allowed"; } catch (e) {}

      // Only share user-level targeting when the visitor has allowed cookies.
      var user = (cookiesAllowed && typeof window.userData === "function") ? window.userData() : null;
      var contextTags = extractContextTags();

      var targeting = {
        context: { url: window.location.href },
        device: {
          userAgent: navigator.userAgent,
          type: window.innerWidth < 768 ? "mobile" : "desktop",
          platform: detectPlatform()
        }
      };
      if (contextTags.length > 0) targeting.context.tags = contextTags;
      if (user && user.followed_tags) {
        targeting.user = { tag: user.followed_tags };
        if (user.experience_level) targeting.user.experience_level = [String(user.experience_level)];
      }

      var res = await fetch("https://adsapi.daily.dev/v1/publishers/" + PUBLISHER, {
        method: "POST",
        headers: { "Content-Type": "application/json", "X-Publisher-Key": PUBLISHER_KEY },
        body: JSON.stringify({
          placement: PLACEMENT,
          targeting: targeting,
          privacy: { measurementAllowed: cookiesAllowed },
          metadata: {
            forem_theme: document.documentElement.getAttribute("data-theme") || "default",
            source: "billboard_tag"
          }
        })
      });

      if (res.status === 200) {
        renderAd(await res.json(), slot);
      } else {
        slot.remove(); // 204 = no fill
      }
    } catch (e) {
      slot.remove();
    }
  }

  function renderAd(ad, container) {
    var native = (ad.creative && ad.creative.native) || {};
    var tracking = ad.tracking || {};
    var advertiser = ad.advertiser || {};

    if (!native.headline || !tracking.clickUrl) { container.remove(); return; }

    container.querySelectorAll(".dd-ad-link, .dd-adv-link").forEach(function(a) {
      a.href = tracking.clickUrl;
    });

    container.querySelector(".dd-ad-headline").textContent = native.headline;
    container.querySelector(".dd-ad-cta").textContent = (native.callToAction || "Learn More") + " →";

    var desc = container.querySelector(".dd-ad-desc");
    if (native.description) desc.textContent = native.description;
    else desc.remove();

    var advName = container.querySelector(".dd-advertiser-name");
    advName.textContent = advertiser.name || "daily.dev";

    if (advertiser.logoUrl) {
      var advLogo = container.querySelector(".dd-advertiser-logo");
      advLogo.src = advertiser.logoUrl;
      advLogo.alt = advertiser.name || "";
      advLogo.style.display = "";
    } else {
      advName.classList.remove("ml-2");
    }

    if (native.imageUrl) {
      var adImg = container.querySelector(".dd-ad-img");
      adImg.src = native.imageUrl;
      adImg.alt = native.headline;
      container.querySelector(".dd-ad-img-wrap").style.display = "";
    }

    container.style.display = "";

    var urls = tracking.impressionUrls || [];
    if (urls.length === 0) return;

    if (!("IntersectionObserver" in window)) {
      urls.forEach(firePixel);
      return;
    }

    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
          urls.forEach(firePixel);
          observer.disconnect();
        }
      });
    }, { threshold: 0.5 });
    observer.observe(container);
  }

  loadAd();
})();
</script>
  </div>

